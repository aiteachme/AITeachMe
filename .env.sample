# AITeachMe 环境变量示例
# 这里只放环境变量：
# - 密钥 / Token / Secret
# - 外部服务地址
# - 部署模式与鉴权参数
# - SMTP / 数据库 / 对象存储 / LangSmith
# - 指向项目运行配置文件的路径
#
# 项目级运行配置统一放在 repo 根目录 `settings.yaml`。

# ==============================
# 1. LLM / OCR 接入
# ==============================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OCR_API_KEY=
# OCR_BASE_URL=

# ==============================
# 2. 文档解析 / 搜索 / Rerank 外部服务
# ==============================
# MINERU_API_TOKEN=
# BING_API_KEY=
# BOCHA_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# TAVILY_API_KEY=
# SEARXNG_BASE_URL=
# RAG_RERANK_API_KEY=
# RAG_RERANK_BASE_URL=

# ==============================
# 3. LangSmith
# ==============================
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=AITeachMe
# 本地开发默认会自动捕获 trace 输入/输出预览，下面两个开关只是覆盖默认策略。
# LANGSMITH_CAPTURE_INPUTS=
# LANGSMITH_CAPTURE_OUTPUTS=
# LANGSMITH_MAX_TEXT_CHARS=2000

# ==============================
# 4. 前端开发
# ==============================
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false

# ==============================
# 5. 项目配置文件 / 启动附加参数
# ==============================
# PROJECT_SETTINGS_PATH=settings.yaml
# EXPORT_OPENAPI_ON_STARTUP=false

# ==============================
# 6. 运行模式与鉴权
# ==============================
# APP_MODE=local
# AUTH_ENABLED=false
# AUTH_TOKEN_SECRET=
# AUTH_TOKEN_TTL_HOURS=720
# GUEST_TOKEN_TTL_HOURS=720
# GUEST_COOKIE_NAME=atm_guest_token
# GUEST_COOKIE_SECURE=
# GUEST_COOKIE_SAMESITE=auto
# APP_VERSION=0.2.0

# ==============================
# 7. SMTP 与邮箱验证码
# ==============================
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=AITeachMe
# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=false
# SMTP_ADDRESS_FAMILY=ipv4
# SMTP_TIMEOUT_S=15
# AUTH_EMAIL_CODE_TTL_S=600
# AUTH_EMAIL_CODE_RESEND_INTERVAL_S=60
# AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# ==============================
# 8. 数据库
# ==============================
# DATABASE_URL=

# ==============================
# 9. 对象存储
# ==============================
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
# S3_ADDRESSING_STYLE=virtual
# S3_CREDENTIAL_MODE=auto
# DOGECLOUD_API_ACCESS_KEY=
# DOGECLOUD_API_SECRET_KEY=
# DOGECLOUD_API_BASE_URL=https://api.dogecloud.com
# DOGECLOUD_SPACE_NAME=
# DOGECLOUD_TMP_TOKEN_PATH=/auth/tmp_token.json
# DOGECLOUD_TMP_TOKEN_CHANNEL=OSS_FULL
# DOGECLOUD_TMP_TOKEN_SCOPE=*

# ==============================
# 10. CORS
# ==============================
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-domain.com
