# AITeachMe 环境变量示例
#
# 这个文件按“基础必填 / 高级可选”分层：
# - 前半部分是大多数本地开发和常规部署真正会用到的项
# - 后半部分是供应商专属、调优和兼容性兜底项
# 大多数项目只需要维护前半部分

# ==============================
# 1. 模型接入
# ==============================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选。留空时后端会根据 LLM_BASE_URL 自动识别 provider。
# LLM_PROVIDER=openai_compatible
# Azure 等需要 API Version 的上游可配置：
# LLM_API_VERSION=2024-10-21

# ==============================
# 2. 常见可选外部服务
# ==============================
# MINERU_API_TOKEN=
# RAG_RERANK_API_KEY=

# ==============================
# 3. LangSmith
# ==============================
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=AITeachMe
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ==============================
# 4. 项目配置与启动
# ==============================
# PROJECT_SETTINGS_PATH=./settings.override.yaml

# ==============================
# 5. 运行模式与鉴权
# ==============================
# APP_MODE=local
# AUTH_ENABLED=
# AUTH_ENABLED 为空时按 APP_MODE 自动推导：local 默认关闭，cloud/Render 默认开启。
# AUTH_TOKEN_SECRET=

# ==============================
# 6. SMTP 与邮箱验证码
# ==============================
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com

# ==============================
# 7. 数据库与对象存储
# ==============================
# DATABASE_URL=
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE_URL=

# ==============================
# 8. CORS 与通知
# ==============================
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-domain.com
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx-xxx-xxx
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx

# ============================================================
# 以下为高级可选项：大多数项目不需要改，只有明确知道用途时再启用
# ============================================================

# ==============================
# 9. 检索 Provider 高级项
# ==============================
# TAVILY_API_KEY=
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_TOPIC=general
# TAVILY_INCLUDE_RAW_CONTENT=false
#
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
# BING_API_KEY=
# BOCHA_API_KEY=
# BOCHA_FRESHNESS=noLimit
#
# JINA_API_KEY=
# JINA_SEARCH_ENRICH=false
# JINA_READER_ENABLED=false
#
# SERPER_API_KEY=
# SERPER_SEARCH_MODE=search
# SERPER_GL=us
# SERPER_HL=en
# SERPER_AUTOCORRECT=true
#
# SEARCHAPI_API_KEY=
# SEARCHAPI_ENGINE=google
# SEARCHAPI_GL=
# SEARCHAPI_HL=
#
# SERPAPI_API_KEY=
# SERPAPI_ENGINE=google
# SERPAPI_GL=
# SERPAPI_HL=
#
# GOOGLE_API_KEY=
# GOOGLE_CX_KEY=
# GOOGLE_SAFE_SEARCH=
# GOOGLE_LR=
#
# PERPLEXITY_API_KEY=
# PERPLEXITY_SEARCH_MODEL=sonar
#
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SEARCH_MODEL=perplexity/sonar
# OPENROUTER_HTTP_REFERER=http://localhost
# OPENROUTER_APP_TITLE=AITeachMe
#
# BAIDU_AI_SEARCH_API_KEY=
# BAIDU_AI_SEARCH_MODEL=ernie-4.5-turbo-32k
# BAIDU_AI_SEARCH_SOURCE=baidu_search_v2
# BAIDU_AI_SEARCH_DEEP=false
#
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=
# PUBMED_DB=pmc
# PUBMED_SORT=relevance
#
# MCP_SEARCH_TOOL=
# MCP_SEARCH_QUERY_ARG=query
# MCP_SEARCH_MAX_RESULTS_ARG=max_results
#
# SEARXNG_BASE_URL=
# RAG_RERANK_BASE_URL=

# ==============================
# 10. LangSmith 高级项
# ==============================
# LANGSMITH_CONNECT_TIMEOUT_S=2
# LANGSMITH_PROBE_TTL_S=60

# ==============================
# 11. 启动辅助
# ==============================
# EXPORT_OPENAPI_ON_STARTUP=false

# ==============================
# 12. 鉴权与访客 Cookie 高级项
# ==============================
# AUTH_TOKEN_TTL_HOURS=720
# GUEST_TOKEN_TTL_HOURS=720
# GUEST_COOKIE_NAME=atm_guest_token
# GUEST_COOKIE_SECURE=
# GUEST_COOKIE_SAMESITE=auto

# ==============================
# 13. SMTP 高级项
# ==============================
# SMTP_FROM_NAME=AITeachMe
# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=false
# SMTP_ADDRESS_FAMILY=ipv4
# SMTP_TIMEOUT_S=15
# AUTH_EMAIL_CODE_TTL_S=600
# AUTH_EMAIL_CODE_RESEND_INTERVAL_S=60
# AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# ==============================
# 14. 数据库迁移辅助
# ==============================
# ALLOW_CLOUD_VECTOR_REBUILD=false

# ==============================
# 15. 对象存储高级项
# ==============================
# S3_SESSION_TOKEN=
# S3_REGION=
# S3_ADDRESSING_STYLE=virtual
# S3_CREDENTIAL_MODE=auto
#
# DOGECLOUD_API_ACCESS_KEY=
# DOGECLOUD_API_SECRET_KEY=
# DOGECLOUD_API_BASE_URL=https://api.dogecloud.com
# DOGECLOUD_SPACE_NAME=
# DOGECLOUD_TMP_TOKEN_PATH=/auth/tmp_token.json
# DOGECLOUD_TMP_TOKEN_CHANNEL=OSS_FULL
# DOGECLOUD_TMP_TOKEN_SCOPE=*
