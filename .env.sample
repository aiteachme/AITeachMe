# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║                     AITeachMe — 统一环境变量配置                            ║
# ╠══════════════════════════════════════════════════════════════════════════════╣
# ║  使用方式：                                                                 ║
# ║  1. 将本文件复制为 .env               cp .env.sample .env                   ║
# ║  2. 按需修改下方变量（至少填写 LLM_API_KEY）                                ║
# ║  3. 前端和后端都会自动读取本文件，无需分别配置                              ║
# ╚══════════════════════════════════════════════════════════════════════════════╝


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🔑  必填：大模型 API 凭证                                                  │
# │     没有 API Key 的话整个系统无法运行，请优先配置                            │
# └──────────────────────────────────────────────────────────────────────────────┘

## 大模型 API 密钥（必填）
## 支持任何 OpenAI 兼容接口的 API Key（百炼、硅基流动、aihubmix 等）
LLM_API_KEY=sk-your-api-key-here

## 大模型接口地址
## 默认值：阿里百炼 DashScope OpenAI 兼容模式
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🤖  模型选择                                                               │
# │     选择用于对话、Embedding 和 OCR 的模型                                   │
# └──────────────────────────────────────────────────────────────────────────────┘

## 主对话模型（用于 Digest 生成、Interact 对话、Examine 判卷等）
LLM_MODEL=qwen-plus-latest

## Embedding 向量模型（用于 RAG 检索、知识图谱构建）
## 常用选项：text-embedding-v3 / text-embedding-v4 / qwen3-embedding-0.6b
EMBEDDING_MODEL=text-embedding-v3

## [可选] 轻量对话模型（用于大纲、审阅等低复杂度任务，留空则回退到 LLM_MODEL）
# LLM_MODEL_LIGHT=qwen-turbo-latest

## [可选] 抽取模型（用于知识图谱实体/关系抽取，留空则回退到 LLM_MODEL）
# LLM_MODEL_EXTRACT=qwen-plus-latest


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 👁  OCR 视觉模型（可选）                                                   │
# │     用于扫描件/图片类 PDF 的 OCR 识别，如果不需要 OCR 可以不配置            │
# └──────────────────────────────────────────────────────────────────────────────┘

## [可选] OCR 模型名称（需要多模态视觉能力，如 qwen-vl-max）
# OCR_MODEL=qwen-vl-max

## [可选] OCR 专用 API Key（留空则复用 LLM_API_KEY）
# OCR_API_KEY=

## [可选] OCR 专用接口地址（留空则复用 LLM_BASE_URL）
# OCR_BASE_URL=

## [可选] 启动 FastAPI 时自动导出 OpenAPI 到前端
## 默认关闭，避免后端运行时顺手修改前端生成文件
# EXPORT_OPENAPI_ON_STARTUP=false


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🌐  前端配置（Vite 构建时注入，变量必须以 VITE_ 开头）                     │
# └──────────────────────────────────────────────────────────────────────────────┘

## 后端 API 地址（前端开发服务器的代理目标）
VITE_API_URL=http://localhost:8000

## 是否使用 Mock 数据（true = 使用本地 Mock，不连后端）
VITE_USE_MOCK=false


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 📂  存储与上传                                                              │
# └──────────────────────────────────────────────────────────────────────────────┘

## 数据目录（SQLite 数据库、上传文件、解析产物等的存储根目录）
# DATA_DIR=./data

## 单文件最大上传大小（MB）
# MAX_UPLOAD_SIZE_MB=50


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🔍  RAG 检索配置                                                            │
# └──────────────────────────────────────────────────────────────────────────────┘

## 检索返回的 Top-K 结果数
# RAG_TOP_K=5

## 相似度过滤阈值（0~1，低于此值的结果会被丢弃）
# RAG_SIMILARITY_THRESHOLD=0.3

## [可选] Rerank 重排模型名称（留空则不启用重排序）
# RAG_RERANK_MODEL=

## [可选] Rerank 专用 API Key
# RAG_RERANK_API_KEY=

## [可选] Rerank 接口地址
# RAG_RERANK_BASE_URL=

## Rerank 后保留的 Top-K 数
# RAG_RERANK_TOP_K=3

## 对话历史保留的轮数
# CHAT_HISTORY_TURNS=10


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ ⚙️  Ingest 解析管线配置                                                     │
# └──────────────────────────────────────────────────────────────────────────────┘

## 文件解析并发数
# INGEST_PARSE_CONCURRENCY=5

## 单文件解析超时时间（秒）
# INGEST_PARSER_TIMEOUT_S=90


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 📝  Digest 知识文档生成配置                                                  │
# └──────────────────────────────────────────────────────────────────────────────┘

## 章节并行写入数
# DOCGEN_MAX_PARALLEL_CHAPTERS=20

## IO 并行度
# DOCGEN_IO_PARALLELISM=20

## 单 chunk 时跳过大纲规划的阈值
# DOCGEN_OUTLINE_FAST_PATH_MAX_CHUNKS=1

## 对已经是干净 Markdown 的内容跳过 LLM 清洗
# DOCGEN_SKIP_LLM_CLEANSE_FOR_CLEAN_MARKDOWN=true

## 单章节时跳过 LLM 审阅
# DOCGEN_SKIP_LLM_REVIEW_FOR_SINGLE_CHAPTER=true

## 审阅快速通道的最大章节数
# DOCGEN_REVIEW_FAST_PATH_MAX_CHAPTERS=1

## 审阅重试模式（targeted / full）
# DOCGEN_REVIEW_RETRY_MODE=targeted

## 元数据 fallback 到 LLM 提取
# DOCGEN_METADATA_FALLBACK_LLM=true


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🛡  AI 基础设施（一般无需修改）                                             │
# └──────────────────────────────────────────────────────────────────────────────┘

## LLM 并发限制（全局信号量防止同时发送过多请求）
# LLM_CONCURRENCY_LIMIT=20

## Embedding 分批大小和批次间延迟
# EMBEDDING_BATCH_SIZE=20
# EMBEDDING_BATCH_DELAY_S=0.1

## 默认 Token 预算
# DEFAULT_TOKEN_BUDGET=4000

## 是否启用 LLM 调用观测/追踪
# LLM_OBSERVABILITY_ENABLED=true
# TRACING_ENABLED=true
# LANGSMITH_TRACING=false
# LANGSMITH_PROJECT=AITeachMe
# LANGSMITH_CAPTURE_INPUTS=true   # 默认：local=true, cloud=false；显式设置后覆盖默认值
# LANGSMITH_CAPTURE_OUTPUTS=true  # 默认：local=true, cloud=false；显式设置后覆盖默认值
# LANGSMITH_MAX_TEXT_CHARS=2000
# LLM_OBSERVABILITY_MAX_RECORDS=5000

## 是否启用内容安全护栏
# GUARDRAILS_ENABLED=true

## LLM 响应结果缓存
# LLM_CACHE_ENABLED=false
# LLM_CACHE_TTL_S=3600
# LLM_CACHE_MAX_ENTRIES=1000


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🔐  应用模式与鉴权（SaaS 部署时使用）                                      │
# └──────────────────────────────────────────────────────────────────────────────┘

## 应用模式：local = 本地单用户 | cloud = SaaS 多用户
# APP_MODE=local

## 是否启用鉴权
# AUTH_ENABLED=false

## JWT 签名密钥（cloud 模式必填，用 openssl rand -hex 32 生成）
# AUTH_TOKEN_SECRET=

## 应用版本号
# APP_VERSION=0.2.0


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🗄  云端数据库（APP_MODE=cloud 时必填）                                     │
# │     支持任何 PostgreSQL 15+ 托管服务（Render / Supabase / Neon / 自建等）    │
# └──────────────────────────────────────────────────────────────────────────────┘

## PostgreSQL 连接串
## 格式：postgresql+psycopg://user:password@host:5432/dbname
## Render 默认给的是 postgres:// 开头，需要手动改为 postgresql+psycopg://
# DATABASE_URL=


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ ☁️  云端对象存储（APP_MODE=cloud 时必填）                                    │
# │     兼容任何 S3 协议供应商（DogeCloud / Cloudflare R2 / 阿里云 OSS / MinIO） │
# └──────────────────────────────────────────────────────────────────────────────┘

## 存储后端：local（默认）| s3
# STORAGE_BACKEND=local

## S3 兼容存储桶名称
# S3_BUCKET=

## S3 接口地址（各供应商不同，参考供应商文档）
# S3_ENDPOINT=

## S3 访问密钥对
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

## S3 区域（留空时默认 us-east-1）
# S3_REGION=

## [可选] 公共访问 CDN 域名（配置后前端可直接通过 CDN 访问资产文件）
# S3_PUBLIC_BASE_URL=

## [可选] S3 bucket 寻址风格：auto | virtual | path
## 腾讯云 COS / DogeCloud 等要求 virtual-hosted style 的服务建议填写 virtual
# S3_ADDRESSING_STYLE=auto


# ┌──────────────────────────────────────────────────────────────────────────────┐
# │ 🌍  CORS 跨域（cloud 模式部署时需要配置）                                   │
# └──────────────────────────────────────────────────────────────────────────────┘

## 允许的前端域名（逗号分隔）
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-domain.com

