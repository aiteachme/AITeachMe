# AITeachMe `.env`
# 这里只放：
# - 密钥 / Token / Secret
# - 部署参数（数据库、对象存储、SMTP、运行模式、前端构建地址）
# 模型名、检索策略、planner/docgen 默认值统一放 repo-root `config.yaml`。

# ==============================
# 1. 基础 AI 接入
# - `LLM_API_KEY` 必填
# - `LLM_BASE_URL` 是 OpenAI 兼容接口地址
# - `OCR_*` 只有 OCR 想走独立账号时才填
# ==============================
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OCR_API_KEY=
# OCR_BASE_URL=

# ==============================
# 2. 检索 / 解析服务接入
# - `MINERU_API_TOKEN`：后端统一调用 MinerU Cloud 时填写
# - `BING_API_KEY` / `BOCHA_API_KEY` / `SEMANTIC_SCHOLAR_API_KEY` / `TAVILY_API_KEY`
#   只在启用对应检索器时填写
# - `RAG_RERANK_API_KEY` / `RAG_RERANK_BASE_URL`
#   只在启用重排服务时填写
# ==============================
# MINERU_API_TOKEN=
# BING_API_KEY=
# BOCHA_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# TAVILY_API_KEY=
# RAG_RERANK_API_KEY=
# RAG_RERANK_BASE_URL=

# ==============================
# 3. LangSmith
# - 只有 `config.yaml` 打开 `langsmith.tracing` 时才需要
# - `LANGSMITH_API_KEY` 和 `LANGCHAIN_API_KEY` 二选一即可
# ==============================
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=

# ==============================
# 4. 前端开发
# - `VITE_API_URL`：前端开发环境访问的后端地址
# - `VITE_USE_MOCK=true`：前端直接走本地 Mock
# ==============================
VITE_API_URL=http://localhost:8000
VITE_USE_MOCK=false

# ==============================
# 5. 本地路径与启动辅助
# - `DATA_DIR`：SQLite、上传文件、构建产物的根目录
# - `PROJECT_CONFIG_PATH`：只有你把 `config.yaml` 挪位置时才改
# - `EXPORT_OPENAPI_ON_STARTUP=true`：启动时导出 OpenAPI 给前端
# ==============================
# DATA_DIR=./data
# PROJECT_CONFIG_PATH=config.yaml
# EXPORT_OPENAPI_ON_STARTUP=false

# ==============================
# 6. 运行模式与鉴权
# - `APP_MODE`：local / cloud / auto
# - `AUTH_ENABLED`：本地单人开发通常可设为 false
# - `AUTH_TOKEN_SECRET`：cloud 模式必须改成你自己的随机值
# - 其余几项是 Token 和游客 Cookie 的部署级参数
# ==============================
# APP_MODE=local
# AUTH_ENABLED=false
# AUTH_TOKEN_SECRET=
# AUTH_TOKEN_TTL_HOURS=720
# GUEST_TOKEN_TTL_HOURS=720
# GUEST_COOKIE_NAME=atm_guest_token
# GUEST_COOKIE_SECURE=
# GUEST_COOKIE_SAMESITE=auto
# APP_VERSION=0.2.0

# ==============================
# 7. SMTP 与邮箱验证码
# - 只有要发邮箱验证码时才需要填写 SMTP
# - `SMTP_PASSWORD` 一般填邮箱授权码，不是邮箱登录密码
# - 最后三项控制验证码有效期、重发间隔和最大尝试次数
# ==============================
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=AITeachMe
# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=false
# SMTP_ADDRESS_FAMILY=ipv4
# SMTP_TIMEOUT_S=15
# AUTH_EMAIL_CODE_TTL_S=600
# AUTH_EMAIL_CODE_RESEND_INTERVAL_S=60
# AUTH_EMAIL_CODE_MAX_ATTEMPTS=5

# ==============================
# 8. 数据库
# - `DATABASE_URL`：PostgreSQL 连接串
# - `APP_MODE=cloud` 时通常必填
# ==============================
# DATABASE_URL=

# ==============================
# 9. 对象存储
# - `STORAGE_BACKEND=local`：本地文件
# - `STORAGE_BACKEND=s3`：对象存储
# - 走 `s3` 时至少要配 `S3_BUCKET`、`S3_ENDPOINT`、`S3_ACCESS_KEY`、`S3_SECRET_KEY`
# - `DOGECLOUD_*` 只在 DogeCloud tmp_token 模式下使用
# ==============================
# STORAGE_BACKEND=local
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=
# S3_REGION=
# S3_PUBLIC_BASE_URL=
# S3_ADDRESSING_STYLE=virtual
# S3_CREDENTIAL_MODE=auto
# DOGECLOUD_API_ACCESS_KEY=
# DOGECLOUD_API_SECRET_KEY=
# DOGECLOUD_API_BASE_URL=https://api.dogecloud.com
# DOGECLOUD_SPACE_NAME=
# DOGECLOUD_TMP_TOKEN_PATH=/auth/tmp_token.json
# DOGECLOUD_TMP_TOKEN_CHANNEL=OSS_FULL
# DOGECLOUD_TMP_TOKEN_SCOPE=*

# ==============================
# 10. CORS
# - `CORS_ALLOWED_ORIGINS`：cloud 模式给前端放开跨域时配置
# ==============================
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-domain.com
