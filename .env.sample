# AITeachMe 用户侧环境变量样例
#
# 这一份就是本地部署与设置页主要对应的环境变量入口：
# - 统一模型接入
# - 学习引擎常用授权
# - 联网搜索 Provider 授权
# - LangSmith 授权
#
# 部署 / 云平台 / 数据库 / 对象存储 / 验证码 / 飞书通知请看 `.env.developer.sample`。

# ==============================
# 1. 统一模型接入
# ==============================
# LLM_API_KEY 支持英文逗号分隔多个同网关 Key，请确保它们都适用于同一个 LLM_BASE_URL。
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 仅在自动识别 provider 失败时填写：
# LLM_PROVIDER=openai_compatible
# Azure 等需要 API Version 的上游可配置：
# LLM_API_VERSION=2024-10-21

# ==============================
# 2. 学习引擎常用授权
# ==============================
# 多个 MinerU Token 可用英文逗号分隔，解析时会随机选择一个。
# MINERU_API_TOKEN=

# ==============================
# 3. 联网搜索 Provider 授权
# ==============================
# 下列联网检索 API Key 支持英文逗号分隔多个 Key；GOOGLE_CX_KEY 仍按单值配置。
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
# BING_API_KEY=
# BOCHA_API_KEY=
# JINA_API_KEY=
# SERPER_API_KEY=
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=
# BAIDU_AI_SEARCH_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CX_KEY=
# SEARCHAPI_API_KEY=
# SERPAPI_API_KEY=
# NCBI_API_KEY=

# ==============================
# 4. LangSmith
# ==============================
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=AITeachMe

# ==============================
# 5. 演示课程 OSS
# ==============================
# 复用现有公共对象存储根地址，后端会固定读取：
#   <S3_PUBLIC_BASE_URL>/demo-courses/catalog/v1/index.json
# S3_PUBLIC_BASE_URL=https://your-cdn-domain

# ==============================
# Local dev ports
# ==============================
AITEACHME_BACKEND_HOST=127.0.0.1
AITEACHME_BACKEND_PORT=9020
AITEACHME_FRONTEND_HOST=127.0.0.1
AITEACHME_FRONTEND_PORT=5180

# Optional override for remote backend usage. Keep unset for local dev.
# VITE_API_URL=

# 需要更多部署变量时，请继续参考：
# - .env.developer.sample      开发 / 部署 / 基础设施 / 验证码 / 通知
