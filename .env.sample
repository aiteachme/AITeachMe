# AITeachMe 用户侧环境变量
# 更多部署变量见 `.env.developer.sample`。

# ==============================
# 1. 模型接入
# ==============================
LLM_API_KEY=<model-api-key>
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 多个主用 key/base_url 可用英文逗号配对；单 base_url + 多 key 会自动共用地址。
# LLM_PROVIDER=openai_compatible
# LLM_API_VERSION=2024-10-21
# 主用模型网关失败时启用备用网关；备用路线使用 provider 默认模型。
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_BASE_URL=
# ==============================
# 2. 学习引擎（可选 bootstrap；本地设置页保存后以数据库为准）
# ==============================
# MINERU_API_TOKENS=
# PADDLE_OCR_API_TOKEN=

# ==============================
# 3. 联网搜索
# ==============================
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=
# BING_API_KEY=
# BOCHA_API_KEY=
# JINA_API_KEY=
# SERPER_API_KEY=
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=
# BAIDU_AI_SEARCH_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CX_KEY=
# SEARCHAPI_API_KEY=
# SERPAPI_API_KEY=
# NCBI_API_KEY=

# ==============================
# 4. LangSmith
# ==============================
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=AITeachMe

# ==============================
# 5. PostHog product analytics
# ==============================
# VITE_POSTHOG_ENABLED=false
# VITE_POSTHOG_TOKEN=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
# VITE_POSTHOG_SESSION_REPLAY=false
# VITE_POSTHOG_DEBUG=false
# POSTHOG_ENABLED=false
# POSTHOG_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_TIMEOUT_S=2
# POSTHOG_RETRY_COUNT=1
# POSTHOG_DEBUG=false
