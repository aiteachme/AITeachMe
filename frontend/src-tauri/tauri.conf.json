{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiTeachMe",
  "version": "0.1.0",
  "identifier": "com.aiteachme.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AiTeachMe",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../../docs/brand/atm-icon.png",
      "../../docs/brand/atm-logo-3_ico_96x96.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "../../docs/brand/atm-logo-3_ico_96x96.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
