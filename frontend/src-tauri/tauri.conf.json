{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiTeachMe",
  "version": "0.0.6-alpha.1",
  "identifier": "com.aiteachme.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AiTeachMe",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../../docs/brand/atm-icon.png",
      "../../docs/brand/app-icon.ico"
    ],
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "installerIcon": "../../docs/brand/app-icon.ico",
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
