{
  "name": "aiteachme-frontend",
  "version": "0.1.6",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "npm run electron:dev",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:window\"",
    "electron:window": "node electron/wait-dev-server.cjs && electron . --dev",
    "electron:preview": "npm run build:desktop && electron .",
    "electron:installer": "electron-builder --config ../packaging/desktop/scripts/electron-builder-config.cjs --win nsis",
    "electron:dist": "npm run electron:installer",
    "desktop:installer": "npm run electron:installer",
    "desktop:dist": "npm run electron:dist",
    "tauri": "tauri",
    "tauri:dev:remote": "tauri dev --config src-tauri/tauri.remote.conf.json",
    "tauri:prepare:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ../packaging/desktop/scripts/prepare-tauri-sidecar.ps1",
    "tauri:dev:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ../packaging/desktop/scripts/dev-tauri-local.ps1",
    "tauri:dev:local:raw": "tauri dev --config src-tauri/tauri.local.conf.json --features local-backend",
    "tauri:build:remote": "tauri build --config src-tauri/tauri.remote.conf.json",
    "tauri:build:local": "npm run tauri:prepare:local && npm run tauri:build:local:raw",
    "tauri:build:local:raw": "tauri build --config src-tauri/tauri.local.conf.json --features local-backend",
    "build": "tsc && vite build",
    "build:desktop": "tsc && vite build --base=./",
    "test:exam-submission-flow": "node --experimental-strip-types tests/exam-submission-flow.test.mjs",
    "test:mastery-drill-progress": "node --experimental-strip-types tests/mastery-drill-progress.test.mjs",
    "test:question-bank-filters": "node --experimental-strip-types tests/question-bank-filters.test.mjs",
    "test:question-template-detail": "node --experimental-strip-types tests/question-template-detail.test.mjs",
    "test:question-marking": "node --experimental-strip-types tests/question-marking.test.mjs",
    "test:study-guide-stream": "node --experimental-strip-types tests/study-guide-stream.test.mjs",
    "test:training-config": "node --experimental-strip-types tests/training-config.test.mjs",
    "test:security": "node --experimental-strip-types tests/markdown-security.test.mjs",
    "test:sse": "node --experimental-strip-types tests/sse.test.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/cli": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/d3": "^7.4.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axios": "^1.18.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.3",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.9",
    "electron": "^41.3.0",
    "electron-builder": "^26.15.3",
    "framer-motion": "^12.38.0",
    "katex": "^0.16.38",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.15.0",
    "msw": "^2.12.11",
    "orval": "^8.18.0",
    "postcss": "^8.4.49",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.17",
    "three": "^0.183.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.57.0",
    "vis-data": "^8.0.3",
    "vis-network": "^10.0.2",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "uuid": "^14.0.0"
  },
  "build": {
    "appId": "com.aiteachme.desktop",
    "productName": "AiTeachMe",
    "electronDist": "node_modules/electron/dist",
    "afterPack": "electron/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/aiteachme-backend",
        "to": "backend"
      },
      {
        "from": "../docs/brand/app-icon.ico",
        "to": "app-icon.ico"
      }
    ],
    "win": {
      "icon": "../docs/brand/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "AiTeachMe Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../docs/brand/app-icon.ico",
      "uninstallerIcon": "../docs/brand/app-icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@posthog/react": "^1.10.2",
    "posthog-js": "^1.390.2",
    "rehype-raw": "^7.0.0"
  }
}
