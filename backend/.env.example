# ============================================================
# 核心配置
# ============================================================

# LLM API 密钥（必填）
LLM_API_KEY=sk-your-api-key-here

# LLM 服务地址（默认：阿里云通义千问）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 模型名称（默认：qwen-plus）
# LLM_MODEL=qwen-plus

# 向量模型名称（默认：text-embedding-v3）
# EMBEDDING_MODEL=text-embedding-v3


# ============================================================
# 文档解析配置（可选）
# ============================================================

# 图片理解模型（用于 PDF/图片中的公式、图表识别）
# 推荐使用多模态模型：qwen-vl-max、qwen-vl-plus、gpt-4o 等
# 未配置时自动使用 LLM_MODEL（如果它支持 vision）
# OCR_MODEL=qwen-vl-max

# 图片理解模型的 API 密钥（未配置时使用 LLM_API_KEY）
# OCR_API_KEY=sk-your-vision-api-key

# 图片理解模型的服务地址（未配置时使用 LLM_BASE_URL）
# OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ============================================================
# 系统配置
# ============================================================

# 数据存储目录（默认：./data）
# DATA_DIR=./data

# 文件上传大小限制（MB，默认：50）
# MAX_UPLOAD_SIZE_MB=50

# RAG 检索返回数量（默认：5）
# RAG_TOP_K=5

# RAG 相似度阈值（默认：0.3）
# RAG_SIMILARITY_THRESHOLD=0.3

# RAG 重排序模型（可选，启用后对检索结果进行精排）
# 推荐：gte-rerank、bge-reranker-v2-m3、cohere-rerank-v3 等
# RAG_RERANK_MODEL=gte-rerank

# RAG 重排序模型 API 密钥（未配置时使用 LLM_API_KEY）
# RAG_RERANK_API_KEY=sk-your-rerank-api-key

# RAG 重排序模型服务地址（未配置时使用 LLM_BASE_URL）
# RAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# RAG 重排序后保留数量（默认：3）
# RAG_RERANK_TOP_K=3

# 对话历史轮数（默认：10）
# CHAT_HISTORY_TURNS=10


# ============================================================
# Digest 构建配置
# ============================================================

# LLM 并行度上限（默认：8，控制 KG 抽取和文档生成的并发数）
# LLM_CONCURRENCY_LIMIT=8

# 文档生成最大并行章节数（默认：4）
# DOCGEN_MAX_PARALLEL_CHAPTERS=4

# 轻量模型名称（用于大纲规划、审阅、元数据提取等轻量任务）
# 未配置时使用 LLM_MODEL
# LLM_MODEL_LIGHT=qwen-turbo

# 抽取模型名称（用于知识图谱实体/关系抽取，需要结构化输出能力）
# 未配置时使用 LLM_MODEL
# LLM_MODEL_EXTRACT=qwen-plus
