# ╔══════════════════════════════════════════════════════════════╗
# ║  AITeachMe 环境配置                                         ║
# ║  复制此文件为 .env 后填写                                    ║
# ║  cp .env.example .env                                       ║
# ╚══════════════════════════════════════════════════════════════╝
#
#  📌  带 ⬅️ 必填  标记的是启动前必须填写的项
#  📌  被 # 注释掉的行都有默认值，不改也能用
#  📌  想改哪个就取消注释并修改值


# ──────────────────────────────────────────────────────────────
# 🔑 必填项（不填无法启动）
# ──────────────────────────────────────────────────────────────

LLM_API_KEY=sk-换成你的密钥                    # ⬅️ 必填！阿里云通义/OpenAI/其他兼容接口的 API Key


# ──────────────────────────────────────────────────────────────
# 🤖 LLM 模型配置（有默认值，不改也行）
# ──────────────────────────────────────────────────────────────

# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # API 地址，默认阿里云通义千问
# LLM_MODEL=qwen-plus                                              # 主力模型，默认 qwen-plus
# EMBEDDING_MODEL=text-embedding-v3                                # 向量模型，默认 text-embedding-v3

# --- 模型分级（可选，省钱用）---
# LLM_MODEL_LIGHT=qwen-turbo                  # 轻量任务（大纲/审阅/元数据），便宜快
# LLM_MODEL_EXTRACT=qwen-plus                 # 抽取任务（知识图谱实体/关系），需要好模型


# ──────────────────────────────────────────────────────────────
# 📸 图片/OCR 识别（可选，不配就不启用 OCR）
# ──────────────────────────────────────────────────────────────
# 用于识别 PDF/图片中的公式、图表、手写内容
# 需要多模态模型：qwen-vl-max / qwen-vl-plus / gpt-4o 等

# OCR_MODEL=qwen-vl-max                       # 视觉模型名称
# OCR_API_KEY=sk-换成你的密钥                    # 不填则复用 LLM_API_KEY
# OCR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1


# ──────────────────────────────────────────────────────────────
# 🔍 RAG 检索配置（有默认值，一般不用改）
# ──────────────────────────────────────────────────────────────

# RAG_TOP_K=5                                  # 检索返回数量，默认 5
# RAG_SIMILARITY_THRESHOLD=0.3                 # 相似度阈值，低于此值丢弃，默认 0.3

# --- Rerank 重排序（可选，效果明显但需额外模型）---
# RAG_RERANK_MODEL=gte-rerank                  # 重排序模型名称
# RAG_RERANK_API_KEY=                          # 不填则复用 LLM_API_KEY
# RAG_RERANK_BASE_URL=                         # 不填则复用 LLM_BASE_URL
# RAG_RERANK_TOP_K=3                           # 重排后保留数量，默认 3


# ──────────────────────────────────────────────────────────────
# 📁 存储与上传（有默认值，一般不用改）
# ──────────────────────────────────────────────────────────────

# DATA_DIR=./data                              # 数据存储目录，默认 ./data
# MAX_UPLOAD_SIZE_MB=50                        # 文件上传大小限制（MB），默认 50


# ──────────────────────────────────────────────────────────────
# ⚡ 性能调优（有默认值，高级用户可调）
# ──────────────────────────────────────────────────────────────

# LLM_CONCURRENCY_LIMIT=20                     # LLM 并发请求上限，默认 20
# DOCGEN_MAX_PARALLEL_CHAPTERS=20              # 文档生成并行章节数，默认 20
# CHAT_HISTORY_TURNS=10                        # 对话历史保留轮数，默认 10
# DEFAULT_TOKEN_BUDGET=4000                    # 单次请求 token 预算，默认 4000
# EMBEDDING_BATCH_SIZE=20                      # 向量化批量大小，默认 20


# ──────────────────────────────────────────────────────────────
# ✉️ 邮箱验证码（SMTP）
# ──────────────────────────────────────────────────────────────

# SMTP_HOST=smtp.qq.com                        # SMTP 服务器地址（必填后才可发验证码）
# SMTP_PORT=465                                # 端口：SSL 常见 465，STARTTLS 常见 587
# SMTP_USERNAME=your_smtp_user                 # SMTP 用户名（可选）
# SMTP_PASSWORD=your_smtp_password             # SMTP 密码/授权码（可选）
# SMTP_FROM_EMAIL=noreply@example.com          # 发件人邮箱（必填后才可发验证码）
# SMTP_FROM_NAME=AITeachMe                     # 发件人名称
# SMTP_USE_SSL=true                            # 是否使用 SMTP over SSL
# SMTP_USE_STARTTLS=false                      # 是否启用 STARTTLS（与 SSL 二选一）
# SMTP_TIMEOUT_S=15                            # SMTP 超时时间（秒）

# AUTH_EMAIL_CODE_TTL_S=600                    # 验证码有效期（秒），默认 10 分钟
# AUTH_EMAIL_CODE_RESEND_INTERVAL_S=60         # 重发最小间隔（秒），默认 60 秒
# AUTH_EMAIL_CODE_MAX_ATTEMPTS=5               # 单个验证码最多错误次数


# ──────────────────────────────────────────────────────────────
# 🔧 开关项（有默认值，一般不用改）
# ──────────────────────────────────────────────────────────────

# APP_MODE=local                               # local = 本地单用户 / cloud = 云端多用户
# LLM_CACHE_ENABLED=false                      # LLM 响应缓存，调试时可开启节省 API 费
# TRACING_ENABLED=true                         # 调用追踪
# GUARDRAILS_ENABLED=true                      # 安全护栏
