# AITeachMe 开发 / 部署环境变量

# ==============================
# 1. 运行模式与鉴权
# ==============================
# APP_MODE=local
# AUTH_ENABLED=
# AUTH_TOKEN_SECRET=
# AUTH_TOKEN_TTL_HOURS=720
# GUEST_TOKEN_TTL_HOURS=720
# GUEST_COOKIE_NAME=atm_guest_token
# GUEST_COOKIE_SECURE=
# GUEST_COOKIE_SAMESITE=auto

# ==============================
# 2. 远程前端与 CORS
# ==============================
# VITE_API_URL=https://your-backend-domain
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-domain.com

# ==============================
# 3. 邮件与通知
# ==============================
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=AITeachMe
# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=false
# SMTP_ADDRESS_FAMILY=ipv4
# SMTP_TIMEOUT_S=15
# AUTH_EMAIL_CODE_TTL_S=600
# AUTH_EMAIL_CODE_RESEND_INTERVAL_S=60
# AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx-xxx-xxx
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx

# ==============================
# 4. 数据库与对象存储
# ==============================
# DATABASE_URL=
# STORAGE_BACKEND=local
#
# S3_BUCKET=
# S3_ENDPOINT=
# S3_PUBLIC_BASE_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=
# S3_REGION=
# S3_ADDRESSING_STYLE=virtual
# S3_CREDENTIAL_MODE=auto
#
# DOGECLOUD_API_ACCESS_KEY=
# DOGECLOUD_API_SECRET_KEY=
# DOGECLOUD_API_BASE_URL=https://api.dogecloud.com
# DOGECLOUD_SPACE_NAME=
# DOGECLOUD_TMP_TOKEN_PATH=/auth/tmp_token.json
# DOGECLOUD_TMP_TOKEN_CHANNEL=OSS_FULL
# DOGECLOUD_TMP_TOKEN_SCOPE=*

# ==============================
# 5. 本地端口
# ==============================
# AITEACHME_BACKEND_PORT=9020
# AITEACHME_FRONTEND_PORT=5180
