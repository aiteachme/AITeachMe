# AITeachMe 开发 / 部署环境变量

# ==============================
# 1. 运行模式与鉴权
# ==============================
# APP_MODE 只通过显式环境变量切换；未配置或配置非法时默认 local，不再根据部署平台自动推断。
# APP_MODE=local
# AUTH_ENABLED=
# AUTH_TOKEN_SECRET=
# AUTH_TOKEN_TTL_HOURS=720
# GUEST_TOKEN_TTL_HOURS=720
# GUEST_COOKIE_NAME=atm_guest_token
# GUEST_COOKIE_SECURE=
# GUEST_COOKIE_SAMESITE=auto
# 构建/考试 SSE 快照兜底间隔。默认 2 秒，优先保证线上实时体感；高并发时可调到 3~8 秒。
# SSE_BUILD_SNAPSHOT_FALLBACK_INTERVAL_S=2
# SSE_EXAM_SNAPSHOT_FALLBACK_INTERVAL_S=2
# 按调用类型覆盖 LLM 单次请求超时/重试次数。类型包括：
# CLASSIFY / CHAT / SUMMARIZE / GRADE / GENERATE / EXTRACT / VISION / REASONING / DOCGEN_LIGHT / DOCGEN / IMAGE_GENERATION
# LLM_TIMEOUT_DOCGEN_S=300
# LLM_TIMEOUT_DOCGEN_LIGHT_S=240
# LLM_MAX_RETRIES_DOCGEN_LIGHT=2

# ==============================
# 2. 线上项目 settings override
# ==============================
# 本地通常不需要配置；Render 可用 Secret File 保存 YAML，再把路径填到这里。
# PROJECT_SETTINGS_PATH=/etc/secrets/settings.private.yaml
# 本地模拟云端时：
# PROJECT_SETTINGS_PATH=settings.private.yaml

# ==============================
# 3. 远程前端与 CORS
# ==============================
# VITE_API_URL=https://your-backend-domain
# CORS_ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://your-domain.com

# ==============================
# 4. 邮件与通知
# ==============================
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=AITeachMe
# SMTP_USE_SSL=true
# SMTP_USE_STARTTLS=false
# SMTP_ADDRESS_FAMILY=ipv4
# SMTP_TIMEOUT_S=15
# AUTH_EMAIL_CODE_TTL_S=600
# AUTH_EMAIL_CODE_RESEND_INTERVAL_S=60
# AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
#
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx-xxx-xxx
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=xxxxxxxx

# ==============================
# 5. 数据库与对象存储
# ==============================
# DATABASE_URL=
# PostgreSQL 连接池。总连接预算约等于实例数 * worker 数 * (DB_POOL_SIZE + DB_MAX_OVERFLOW)。
# 小规格云数据库建议使用 PgBouncer/平台 pooled connection string，并保持应用侧小连接池。
# Render/Sealos 单实例可先用 3~5 个常驻连接、2~5 个临时溢出连接；压测后再调大。
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
# DB_POOL_USE_LIFO=true
# STORAGE_BACKEND=local
#
# S3_PUBLIC_BASE_URL=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_SESSION_TOKEN=
# S3_REGION=
# S3_ADDRESSING_STYLE=virtual
# S3_CREDENTIAL_MODE=auto
# 启动时是否对 S3 执行写/读/删冒烟测试；默认关闭，按需临时打开。
# S3_STARTUP_SMOKE_TEST=false
#
# DOGECLOUD_API_ACCESS_KEY=
# DOGECLOUD_API_SECRET_KEY=
# DOGECLOUD_API_BASE_URL=https://api.dogecloud.com
# DOGECLOUD_SPACE_NAME=
# DOGECLOUD_TMP_TOKEN_PATH=/auth/tmp_token.json
# DOGECLOUD_TMP_TOKEN_CHANNEL=OSS_FULL
# DOGECLOUD_TMP_TOKEN_SCOPE=*

# ==============================
# 6. 本地端口
# ==============================
# AITEACHME_BACKEND_PORT=9020
# AITEACHME_FRONTEND_PORT=5180
